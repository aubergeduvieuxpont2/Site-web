{
  "$schema": "/node_modules/wrangler/config-schema.json",
  "name": "site-web-hubspot",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Internal service-binding-only Worker: keep it off the public internet so
  // /ops/* is never reachable except through the API binding.
  "workers_dev": false,
  "preview_urls": false,

  // HubSpot gateway Worker — internal service binding, no public route.
  // Cron-triggered to drain the outbox every minute.
  "vars": {
    "HUBSPOT_PIPELINE_ID": "",
    "HUBSPOT_DEALSTAGE_ID": "",
    "HUBSPOT_TIMELINE_EVENT_TEMPLATE_ID": ""
  },

  // Database access goes through `getSql(env)` in src/db.ts, which prefers the
  // HYPERDRIVE binding and falls back to DB_CONN. Add the binding here at the
  // same time as apps/api — this Worker queries the same database, so leaving
  // it behind would point it at a provider the rest of the stack has left.
  //
  // Every 5 minutes, matching apps/api. A per-minute schedule keeps Neon's
  // serverless compute from ever autosuspending, which is what exhausted the
  // compute quota and took the whole API down. #77 fixed the API's cron but
  // missed this one, so this Worker kept waking the database every minute.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "hyperdrive": [
    {
      "binding": "aivendb",
      "id": "6deff7b9bda6413b9f5d26e560736591"
    }
  ]
}
